    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tooling.tsbuildinfo"
  },
  "include": ["*.ts", "e2e", "tooling", ".storybook"],
  "references": [{ "path": "packages/tokens" }, { "path": "packages/ui" }]
}
